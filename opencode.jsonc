{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/share/meristem/tools/node_modules/.bin/codebase-memory-mcp"
      ],
      "cwd": "/home/myrqyry/loam/rikkahub-local",
      "environment": {
        "CBM_ALLOWED_ROOT": "/home/myrqyry/loam/rikkahub-local"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
